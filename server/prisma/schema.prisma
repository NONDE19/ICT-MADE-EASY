generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  province    String
  district    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  classes     Class[]
  auditLogs   AuditLog[]

  @@index([code])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  fullName     String
  role         String   @default("PUPIL") // ADMIN | TEACHER | PUPIL
  isActive     Boolean  @default(true)
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  school              School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  classMemberships    ClassMembership[]
  teacherAssignments  TeacherAssignment[]
  createdExercises    PracticalExercise[]  @relation("ExerciseCreator")
  attempts            PupilAttempt[]
  assessmentResults   AssessmentResult[]
  learningProgress    LearningProgress[]
  virtualDesktopState VirtualDesktopState?
  achievements        UserAchievement[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([schoolId, role])
  @@index([email])
}

model Class {
  id          String   @id @default(cuid())
  name        String
  gradeLevel  String
  academicYear String  @default("2026")
  schoolId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  memberships        ClassMembership[]
  teacherAssignments TeacherAssignment[]
  exercises          PracticalExercise[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId])
}

model ClassMembership {
  id        String   @id @default(cuid())
  classId   String
  pupilId   String
  joinedAt  DateTime @default(now())

  classObj  Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  pupil     User     @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  @@unique([classId, pupilId])
  @@index([pupilId])
}

model TeacherAssignment {
  id         String   @id @default(cuid())
  classId    String
  teacherId  String
  assignedAt DateTime @default(now())

  classObj   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([teacherId])
}

model LearningModule {
  id           String   @id @default(cuid())
  slug         String   @unique
  number       Int      @unique
  formLevel    Int      @default(1) // 1 = Form 1, 2 = Form 2, 3 = Form 3, 4 = Form 4
  syllabusCode String   @default("1.1")
  title        String
  subtitle     String
  description  String
  category     String
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons     Lesson[]
  resources   LearningResource[]
  exercises   PracticalExercise[]
  questions   AssessmentQuestion[]
  progress    LearningProgress[]

  @@index([formLevel])
}

model Lesson {
  id            String   @id @default(cuid())
  moduleId      String
  slug          String   @unique
  orderIndex    Int
  title         String
  summary       String
  contentJson   String   // Structured educational sections & knowledge checks
  estimatedMins Int      @default(15)
  offlineReady  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module        LearningModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LearningProgress[]

  @@index([moduleId, orderIndex])
}

model LearningResource {
  id           String   @id @default(cuid())
  moduleId     String
  title        String
  resourceType String   // DIAGRAM | GUIDE | REFERENCE | WORKSHEET
  content      String
  createdAt    DateTime @default(now())

  module       LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model PracticalExercise {
  id            String    @id @default(cuid())
  moduleId      String
  title         String
  description   String
  instructions  String
  formLevel     Int       @default(1) // 1..4 Zambian Ordinary Level Form
  syllabusCode  String    @default("1.3")
  level         Int       @default(1) // 1 = Guided, 2 = Independent, 3 = Practical Assessment
  totalMarks    Int       @default(20)
  deadline      DateTime?
  classId       String?
  createdById   String?
  isPublished   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  module        LearningModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  targetClass   Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("ExerciseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  criteria      AssessmentCriteria[]
  attempts      PupilAttempt[]

  @@index([moduleId, level])
  @@index([formLevel])
  @@index([classId])
}

model AssessmentQuestion {
  id            String   @id @default(cuid())
  moduleId      String
  questionText  String
  optionsJson   String   // JSON array of strings
  correctIndex  Int
  explanation   String
  marks         Int      @default(2)
  difficulty    String   @default("STANDARD") // BASIC | STANDARD | CHALLENGE
  createdAt     DateTime @default(now())

  module        LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model AssessmentCriteria {
  id           String   @id @default(cuid())
  exerciseId   String
  orderIndex   Int
  label        String
  ruleType     String   // FOLDER_EXISTS | SUBFOLDER_EXISTS | FILE_EXISTS | FILE_IN_FOLDER | DOC_CONTAINS | DOC_FORMATTED | SHEET_HAS_FORMULA | SHEET_MIN_ROWS | DECK_MIN_SLIDES | ACTION_PERFORMED
  rulePayload  String   // JSON parameters for reusable evaluator
  marks        Int      @default(5)
  hintText     String   @default("")

  exercise     PracticalExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, orderIndex])
}

model PupilAttempt {
  id             String   @id @default(cuid())
  pupilId        String
  exerciseId     String?
  moduleId       String?
  attemptType    String   // PRACTICAL | QUIZ | HARDWARE_LAB
  actionsLogJson String   @default("[]")
  snapshotJson   String   @default("{}")
  status         String   @default("SUBMITTED") // IN_PROGRESS | SUBMITTED | GRADED
  startedAt      DateTime @default(now())
  submittedAt    DateTime?

  pupil          User               @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  exercise       PracticalExercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  result         AssessmentResult?

  @@index([pupilId, attemptType])
  @@index([exerciseId])
}

model AssessmentResult {
  id            String   @id @default(cuid())
  attemptId     String   @unique
  pupilId       String
  awardedMarks  Int
  totalMarks    Int
  percentage    Float
  passed        Boolean
  feedbackJson  String   // Detailed per-criterion or per-question breakdown
  gradedAt      DateTime @default(now())

  attempt       PupilAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  pupil         User         @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  @@index([pupilId, gradedAt])
}

model LearningProgress {
  id              String   @id @default(cuid())
  pupilId         String
  moduleId        String
  lessonId        String?
  status          String   @default("IN_PROGRESS") // NOT_STARTED | IN_PROGRESS | COMPLETED
  percentComplete Int      @default(0)
  lastAccessedAt  DateTime @default(now())
  completedAt     DateTime?

  pupil           User           @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  module          LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson          Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([pupilId, moduleId, lessonId])
  @@index([pupilId])
}

model VirtualDesktopState {
  id             String   @id @default(cuid())
  pupilId        String   @unique
  wallpaper      String   @default("zambia-dawn")
  themeMode      String   @default("dark")
  iconSize       String   @default("medium")
  showClock      Boolean  @default(true)
  settingsJson   String   @default("{}")
  updatedAt      DateTime @updatedAt

  pupil          User              @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  folders        SimulatedFolder[]
  files          SimulatedFile[]
}

model SimulatedFolder {
  id             String   @id @default(cuid())
  desktopStateId String
  name           String
  parentId       String?
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  desktopState   VirtualDesktopState @relation(fields: [desktopStateId], references: [id], onDelete: Cascade)
  files          SimulatedFile[]

  @@index([desktopStateId, parentId, isDeleted])
}

model SimulatedFile {
  id             String   @id @default(cuid())
  desktopStateId String
  folderId       String?
  name           String
  fileType       String   // document | spreadsheet | presentation | text
  extension      String   @default(".vdoc")
  contentJson    String   @default("{}")
  sizeBytes      Int      @default(128)
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  desktopState   VirtualDesktopState @relation(fields: [desktopStateId], references: [id], onDelete: Cascade)
  folder         SimulatedFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([desktopStateId, folderId, isDeleted])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  iconName    String
  points      Int      @default(50)

  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  category  String   @default("INFO") // INFO | ASSIGNMENT | ASSESSMENT | SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SystemSetting {
  key         String   @id
  value       String
  description String   @default("")
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  schoolId  String?
  action    String
  entity    String
  entityId  String?
  details   String   @default("")
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([userId])
}
