# Database connection (SQLite for local installation)
DATABASE_URL="file:./dev.db"

# JWT Secrets (Change these to strong random strings in production!)
JWT_SECRET="change-this-in-production-use-a-long-random-string"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"

# Server Configuration
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# AI Studio Runtime Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
